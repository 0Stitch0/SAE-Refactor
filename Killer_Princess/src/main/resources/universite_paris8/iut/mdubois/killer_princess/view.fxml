    <StackPane fx:id="ecranFinPartie" opacity="0.0" mouseTransparent="true" prefHeight="672.0" prefWidth="960.0" style="-fx-font-size: 40px; -fx-font-weight: bold;">
        <children>
            <!-- <Label fx:id="texteFin" style="-fx-font-size: 50px; -fx-text-fill: white; -fx-font-weight: bold;" translateX="350" translateY="80"/> -->
            <StackPane StackPane.alignment="TOP_CENTER" mouseTransparent="true">
                <ImageView fx:id="victoire" opacity="0" translateX="250" translateY="25">
                    <Image url="@Vague/Victory.png"></Image>
                </ImageView>
                <ImageView fx:id="perte" opacity="0" translateX="250" translateY="25">
                    <Image url="@Vague/Game_Over.png"></Image>
                </ImageView>
            </StackPane>
        </children>
