<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Button?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="universite_paris8.iut.mdubois.killer_princess.controleur.Controleur">
    <top>
        <HBox fx:id="top" alignment="CENTER" mouseTransparent="false" prefHeight="50.0" spacing="150.0" style="-fx-background-color: grey;" BorderPane.alignment="CENTER">
            <children>
                <ImageView fx:id="iconPause" fitHeight="31.0" fitWidth="35.0" onMouseClicked="#basculerPause">
                    <Image url="@Menu/Pause.png" />
                </ImageView>
                <Label fx:id="goldDisplay" text="Pièces : 200" textFill="white">
                    <font> <Font name="Kokonor Regular" size="18.0" /> </font>
                </Label>
                <Label fx:id="waveDisplay" text="Vague : 1 / 5" textFill="white">
                    <font> <Font name="Kokonor Regular" size="18.0" /> </font>
                </Label>
                <HBox>
                    <Label text="Chrono : " textFill="white">
                        <font> <Font name="Kokonor Regular" size="18.0" /> </font>
                    </Label>
                    <Label fx:id="chrono" text="0" textFill="white"  alignment="CENTER" prefHeight="46.0" prefWidth="30.0"/>
                </HBox>
                <ImageView fx:id="iconMenu" fitHeight="37.0" fitWidth="37.0" onMouseClicked="#menuJeu">
                    <Image url="@Menu/iconMenu.png" />
                </ImageView>
            </children>
        </HBox>
    </top>
    <center>
        <StackPane>
            <TilePane fx:id="panneauTuile" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
            <ImageView fx:id="imagePrincesse" fitHeight="165.0" fitWidth="100.0" preserveRatio="true" StackPane.alignment="CENTER_LEFT">
                <Image url="@Chateau/Princesse_Chateau.png"/>
            </ImageView>
            <ImageView fx:id="imageDragon" fitHeight="165.0" fitWidth="120.0" preserveRatio="true" translateX="-425.0" translateY="50.0">
                <Image url="@Chateau/Chateau_Dragon.png"/>
            </ImageView>
            <Pane fx:id="paneEntitee" mouseTransparent="false">
<!--                <Button onAction="#basculerPause" text="PAUSE" />-->
            </Pane>

            <!-- Vague -->
            <StackPane mouseTransparent="true" StackPane.alignment="CENTER">
                <ImageView fx:id="nouvelleVague" fitHeight="600" fitWidth="600" opacity="0" preserveRatio="true">
                    <Image url="@Vague/nouvelleVague.png" />
                </ImageView>
                <ImageView fx:id="trois" opacity="0">
                    <Image url="@Vague/3.png" />
                </ImageView>
                <ImageView fx:id="deux" opacity="0">
                    <Image url="@Vague/2.png" />
                </ImageView>
                <ImageView fx:id="un" opacity="0">
                    <Image url="@Vague/1.png" />
                </ImageView>
            </StackPane>

            <!-- Menu Jeu -->
            <Pane fx:id="menuJeu" mouseTransparent="true" opacity="0">
                <ImageView fitHeight="700" fitWidth="700" layoutX="139.0" layoutY="3.0">
                    <Image url="@Menu/Bouclier.png" />
                </ImageView>
                <ImageView fx:id="backToMenu" fitHeight="70.0" fitWidth="275.0" layoutX="355.0" layoutY="230.0" onMouseClicked="#backToMenu" preserveRatio="true">
                    <Image url="@Menu/BackToMenu.png" />
                </ImageView>
                <ImageView fx:id="restartGame" fitHeight="50.0" fitWidth="155.0" layoutX="420.0" layoutY="319.0" onMouseClicked="#restartGame" preserveRatio="true">
                    <Image url="@Menu/Restart.png" />
                </ImageView>
                <ImageView fx:id="returnMenu" fitHeight="52.0" fitWidth="121.0" layoutX="428.0" layoutY="409.0" onMouseClicked="#returnToGame" preserveRatio="true">
                    <Image url="@Menu/Return.png" />
                </ImageView>
            </Pane>
        </StackPane>


    </center>

    <!-- Achat piège-->
